generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id            Int                @id @default(autoincrement())
  name          String
  email         String             @unique
  passwordHash  String
  role          String             @default("admin")
  status        String             @default("active")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  customers     Customer[]         @relation("CustomerOwner")
  metrics       ChannelDailyMetric[] @relation("MetricCreator")
  periodMetrics ChannelMetricPeriod[] @relation("PeriodMetricCreator")
  importBatches MetricImportBatch[] @relation("ImportCreator")
  followups     CustomerFollowup[] @relation("FollowupOwner")
  orders        Order[]            @relation("OrderCreator")
  salesOrders   Order[]            @relation("OrderSalesperson")
  orderStatusLogs OrderStatusLog[] @relation("OrderStatusLogCreator")
  orderPayments OrderPayment[]     @relation("OrderPaymentCreator")
  orderShipments OrderShipment[]   @relation("OrderShipmentCreator")
  attachments   Attachment[]       @relation("AttachmentUploader")
  influencerCollaborations InfluencerCollaboration[] @relation("InfluencerOwner")
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String
  code        String    @unique
  website     String?
  defaultCurrency String @default("CNY")
  description String?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  stores      Store[]
  channels    Channel[]
  metrics     ChannelDailyMetric[]
  periodMetrics ChannelMetricPeriod[]
  customers   Customer[]
  inquiries   Inquiry[]
  quotes      Quote[]
  orders      Order[]
  products    Product[]
  influencerCollaborations InfluencerCollaboration[]
}

model Platform {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  type      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stores    Store[]
  channels  Channel[]
  metrics   ChannelDailyMetric[]
  periodMetrics ChannelMetricPeriod[]
  inquiries     Inquiry[]
  quotes        Quote[]
  orders        Order[]
}

model Store {
  id                 Int      @id @default(autoincrement())
  brandId            Int
  platformId         Int
  name               String   @unique
  domain             String?
  storeType          String
  marketScope        String
  primaryMarketCode  String?
  defaultCurrency    String   @default("USD")
  settlementCurrency String?
  manager            String?
  status             String   @default("active")
  remark             String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  brand              Brand    @relation(fields: [brandId], references: [id])
  platform           Platform @relation(fields: [platformId], references: [id])
  channels           Channel[]
  metrics            ChannelDailyMetric[]
  periodMetrics      ChannelMetricPeriod[]
  inquiries          Inquiry[]
  quotes             Quote[]
  orders             Order[]

  @@index([brandId])
  @@index([platformId])
}

model Channel {
  id            Int      @id @default(autoincrement())
  brandId       Int?
  platformId    Int?
  storeId       Int?
  businessLine  String
  channelGroup  String?
  channelName   String
  channelType   String
  status        String   @default("active")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  brand         Brand?   @relation(fields: [brandId], references: [id])
  platform      Platform? @relation(fields: [platformId], references: [id])
  store         Store?   @relation(fields: [storeId], references: [id])
  metrics       ChannelDailyMetric[]
  periodMetrics ChannelMetricPeriod[]
  customers     Customer[] @relation("CustomerSourceChannel")
  inquiries     Inquiry[]
  quotes        Quote[]
  orders        Order[]
  influencerCollaborations InfluencerCollaboration[]

  @@unique([businessLine, channelName, storeId])
  @@index([brandId])
  @@index([platformId])
  @@index([storeId])
}

model Vendor {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  vendorType  String   @default("supplier")
  countryCode String?
  contact     String?
  email       String?
  phone       String?
  whatsapp    String?
  website     String?
  remark      String?  @db.Text
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]

  @@index([vendorType])
  @@index([countryCode])
  @@index([status])
}

model Product {
  id                   Int      @id @default(autoincrement())
  sku                  String   @unique
  name                 String
  specification        String?
  category             String?
  defaultPurchasePrice Decimal  @default(0) @db.Decimal(18, 2)
  defaultPackagingCost Decimal  @default(0) @db.Decimal(18, 2)
  currency             String   @default("CNY")
  weight               Decimal? @db.Decimal(18, 3)
  volume               Decimal? @db.Decimal(18, 3)
  defaultVendorId      Int?
  brandId              Int?
  status               String   @default("active")
  remark               String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  defaultVendor        Vendor?  @relation(fields: [defaultVendorId], references: [id], onDelete: SetNull)
  brand                Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  orderItems           OrderItem[]

  @@index([defaultVendorId])
  @@index([brandId])
  @@index([status])
  @@index([category])
  @@index([name])
}

model Country {
  id     Int    @id @default(autoincrement())
  name   String
  code   String @unique
  region String?
  status String @default("active")
}

model Currency {
  id     Int    @id @default(autoincrement())
  code   String @unique
  name   String
  symbol String
  status String @default("active")
}

model ExchangeRate {
  id             Int      @id @default(autoincrement())
  baseCurrency   String
  targetCurrency String
  rate           Decimal  @db.Decimal(18, 6)
  rateDate       DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([baseCurrency, targetCurrency, rateDate])
}

model ChannelDailyMetric {
  id                  Int      @id @default(autoincrement())
  date                DateTime
  brandId             Int
  platformId          Int
  storeId             Int?
  channelId           Int
  countryCode         String?
  currency            String
  salesAmountOriginal Decimal  @default(0) @db.Decimal(18, 2)
  adSpendOriginal     Decimal  @default(0) @db.Decimal(18, 2)
  refundAmountOriginal Decimal @default(0) @db.Decimal(18, 2)
  orderCount          Int      @default(0)
  visitorCount        Int      @default(0)
  exchangeRate        Decimal  @default(1) @db.Decimal(18, 6)
  salesAmountBase     Decimal  @default(0) @db.Decimal(18, 2)
  adSpendBase         Decimal  @default(0) @db.Decimal(18, 2)
  refundAmountBase    Decimal  @default(0) @db.Decimal(18, 2)
  remark              String?
  createdBy           Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  brand               Brand    @relation(fields: [brandId], references: [id])
  platform            Platform @relation(fields: [platformId], references: [id])
  store               Store?   @relation(fields: [storeId], references: [id])
  channel             Channel  @relation(fields: [channelId], references: [id])
  creator             User?    @relation("MetricCreator", fields: [createdBy], references: [id])

  @@index([date])
  @@index([brandId])
  @@index([platformId])
  @@index([storeId])
  @@index([channelId])
}

model ChannelMetricPeriod {
  id                   Int      @id @default(autoincrement())
  year                 Int
  month                Int
  quarter              Int
  weekNumber           Int?
  periodType           String
  brandId              Int
  platformId           Int
  storeId              Int?
  channelId            Int
  countryCode          String?
  currency             String
  salesAmountOriginal  Decimal  @default(0) @db.Decimal(18, 2)
  adSpendOriginal      Decimal  @default(0) @db.Decimal(18, 2)
  refundAmountOriginal Decimal  @default(0) @db.Decimal(18, 2)
  orderCount           Int      @default(0)
  visitorCount         Int      @default(0)
  exchangeRate         Decimal  @default(1) @db.Decimal(18, 6)
  salesAmountBase      Decimal  @default(0) @db.Decimal(18, 2)
  adSpendBase          Decimal  @default(0) @db.Decimal(18, 2)
  refundAmountBase     Decimal  @default(0) @db.Decimal(18, 2)
  businessBlock        String?
  productCostBase      Decimal  @default(0) @db.Decimal(18, 2)
  otherCostBase        Decimal  @default(0) @db.Decimal(18, 2)
  manualRating         String?
  aiRating             String?
  ratingSource         String   @default("none")
  aiAnalysisStatus     String   @default("pending")
  aiSummary            String?  @db.Text
  aiActionSuggestion   String?  @db.Text
  manualActionSuggestion String? @db.Text
  aiRiskNotes          String?  @db.Text
  warningType          String?
  warningLevel         String?
  decisionOwner        String?
  decisionDeadline     DateTime?
  nextBudgetBase       Decimal? @db.Decimal(18, 2)
  budgetAdjustReason   String?  @db.Text
  aiAnalyzedAt         DateTime?
  aiModel              String?
  aiConfidence         String?
  aiDataCoverage       String?  @db.Text
  aiRatingReason       String?  @db.Text
  remark               String?  @db.Text
  createdBy            Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  brand                Brand    @relation(fields: [brandId], references: [id])
  platform             Platform @relation(fields: [platformId], references: [id])
  store                Store?   @relation(fields: [storeId], references: [id])
  channel              Channel  @relation(fields: [channelId], references: [id])
  creator              User?    @relation("PeriodMetricCreator", fields: [createdBy], references: [id])

  @@unique([year, month, periodType, weekNumber, channelId], map: "cmp_week_channel_unique")
  @@index([year, month])
  @@index([year, quarter])
  @@index([periodType])
  @@index([weekNumber])
  @@index([brandId])
  @@index([platformId])
  @@index([storeId])
  @@index([channelId])
  @@index([businessBlock])
  @@index([ratingSource])
  @@index([aiAnalysisStatus])
  @@index([warningLevel])
  @@index([decisionDeadline])
}

model BusinessBlockPlan {
  id                     Int      @id @default(autoincrement())
  year                   Int
  month                  Int
  quarter                Int?
  brandId                Int?
  businessBlock          String
  salesAmountBase        Decimal  @default(0) @db.Decimal(18, 2)
  adSpendBase            Decimal  @default(0) @db.Decimal(18, 2)
  productCostBase        Decimal  @default(0) @db.Decimal(18, 2)
  otherCostBase          Decimal  @default(0) @db.Decimal(18, 2)
  grossProfitBase        Decimal  @default(0) @db.Decimal(18, 2)
  grossMargin            Decimal? @db.Decimal(18, 6)
  roi                    Decimal? @db.Decimal(18, 6)
  monthOverMonth         Decimal? @db.Decimal(18, 6)
  manualRating           String?
  manualActionSuggestion String?  @db.Text
  decisionOwner          String?
  decisionDeadline       DateTime?
  remark                 String?  @db.Text
  aiRating               String?
  aiSummary              String?  @db.Text
  aiActionSuggestion     String?  @db.Text
  aiRiskNotes            Json?
  aiAnalysisStatus       String   @default("pending")
  aiAnalyzedAt           DateTime?
  aiModel                String?
  aiConfidence           String?
  aiDataCoverage         String?  @db.Text
  aiRatingReason         String?  @db.Text
  decisionStatus         String   @default("ai_suggested")
  confirmedBy            Int?
  confirmedAt            DateTime?
  nextBudgetBase         Decimal? @db.Decimal(18, 2)
  budgetAdjustAmount     Decimal? @db.Decimal(18, 2)
  budgetAdjustRatio      Decimal? @db.Decimal(18, 6)
  budgetAdjustReason     String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([year, month, brandId, businessBlock], map: "bbp_month_brand_block_unique")
  @@index([year, month])
  @@index([brandId])
  @@index([businessBlock])
  @@index([aiAnalysisStatus])
  @@index([decisionDeadline])
}

// 公司级 AI 经营总评:把当月四板块汇总喂给 AI,产出整体评价、第一优先动作、预算挪动建议
model CompanyMonthlyReview {
  id                     Int      @id @default(autoincrement())
  year                   Int
  month                  Int
  brandId                Int?
  salesAmountBase        Decimal  @default(0) @db.Decimal(18, 2)
  adSpendBase            Decimal  @default(0) @db.Decimal(18, 2)
  grossProfitBase        Decimal  @default(0) @db.Decimal(18, 2)
  grossMargin            Decimal? @db.Decimal(18, 6)
  roi                    Decimal? @db.Decimal(18, 6)
  overallRating          String?
  overallSummary         String?  @db.Text
  topPriority            String?  @db.Text
  capitalShiftSuggestion String?  @db.Text
  aiRiskNotes            Json?
  aiModel                String?
  aiConfidence           String?
  aiAnalysisStatus       String   @default("pending")
  aiAnalyzedAt           DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([year, month, brandId], map: "cmr_month_brand_unique")
  @@index([year, month])
}

model BusinessWarning {
  id                     Int      @id @default(autoincrement())
  year                   Int
  month                  Int
  brandId                Int?
  businessBlock          String
  channelId              Int?
  warningType            String
  warningLevel           String
  currentValue           Decimal  @default(0) @db.Decimal(18, 2)
  monthOverMonth         Decimal? @db.Decimal(18, 6)
  manualActionSuggestion String?  @db.Text
  aiActionSuggestion     String?  @db.Text
  aiSummary              String?  @db.Text
  aiRiskNotes            Json?
  aiAnalysisStatus       String   @default("pending")
  decisionOwner          String?
  decisionDeadline       DateTime?
  remark                 String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([year, month])
  @@index([brandId])
  @@index([businessBlock])
  @@index([channelId])
  @@index([warningLevel])
  @@index([decisionDeadline])
  @@index([aiAnalysisStatus])
}

model MetricImportBatch {
  id           Int      @id @default(autoincrement())
  fileName     String
  sourceType   String
  importMonth  String
  status       String   @default("pending")
  totalRows    Int      @default(0)
  successRows  Int      @default(0)
  failedRows   Int      @default(0)
  errorMessage String?  @db.Text
  createdBy    Int?
  createdAt    DateTime @default(now())
  creator      User?    @relation("ImportCreator", fields: [createdBy], references: [id])

  @@index([createdBy])
}

model Customer {
  id              Int      @id @default(autoincrement())
  name            String
  customerType    String
  countryCode     String?
  email           String?
  phone           String?
  whatsapp        String?
  website         String?
  companyName     String?
  sourceChannelId Int?
  brandId         Int?
  ownerId         Int?
  level           String   @default("C")
  status          String   @default("new")
  tags            Json?
  remark          String?  @db.Text
  lastFollowupAt  DateTime?
  nextFollowupAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sourceChannel   Channel? @relation("CustomerSourceChannel", fields: [sourceChannelId], references: [id])
  brand           Brand?   @relation(fields: [brandId], references: [id])
  owner           User?    @relation("CustomerOwner", fields: [ownerId], references: [id])
  contacts        CustomerContact[]
  followups       CustomerFollowup[]
  inquiries       Inquiry[]
  quotes          Quote[]
  orders          Order[]

  @@index([sourceChannelId])
  @@index([brandId])
  @@index([ownerId])
  @@index([name])
  @@index([email])
  @@index([countryCode])
  @@index([status])
  @@index([level])
  @@index([nextFollowupAt])
}

model CustomerContact {
  id         Int      @id @default(autoincrement())
  customerId Int
  name       String
  position   String?
  email      String?
  phone      String?
  whatsapp   String?
  isPrimary  Boolean  @default(false)
  remark     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerFollowup {
  id             Int      @id @default(autoincrement())
  customerId     Int
  inquiryId      Int?
  followupType   String
  content        String   @db.Text
  result         String?  @db.Text
  nextFollowupAt DateTime?
  ownerId        Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  owner          User?    @relation("FollowupOwner", fields: [ownerId], references: [id])

  @@index([customerId])
  @@index([ownerId])
  @@index([nextFollowupAt])
}

model InfluencerCollaboration {
  id               Int       @id @default(autoincrement())
  influencerName   String
  platform         String
  accountHandle    String?
  profileUrl       String?
  countryCode      String?
  followerCount    Int       @default(0)
  avgViews         Int       @default(0)
  contentCategory  String?
  cooperationType  String    @default("sample")
  status           String    @default("prospecting")
  brandId          Int?
  channelId        Int?
  ownerId          Int?
  contactName      String?
  email            String?
  whatsapp         String?
  startDate        DateTime?
  endDate          DateTime?
  sampleSku        String?
  sampleQuantity   Int       @default(0)
  sampleCost       Decimal   @default(0) @db.Decimal(18, 2)
  feeAmount        Decimal   @default(0) @db.Decimal(18, 2)
  currency         String    @default("USD")
  exchangeRate     Decimal   @default(1) @db.Decimal(18, 6)
  totalCostBase    Decimal   @default(0) @db.Decimal(18, 2)
  contentCount     Int       @default(0)
  postUrl          String?
  couponCode       String?
  salesAmount      Decimal   @default(0) @db.Decimal(18, 2)
  orderCount       Int       @default(0)
  roi              Decimal?  @db.Decimal(18, 6)
  rating           String?
  nextFollowupAt   DateTime?
  remark           String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  brand            Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  channel          Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  owner            User?     @relation("InfluencerOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  orders           Order[]

  @@index([influencerName])
  @@index([platform])
  @@index([status])
  @@index([cooperationType])
  @@index([brandId])
  @@index([channelId])
  @@index([ownerId])
  @@index([nextFollowupAt])
}

model Inquiry {
  id              Int      @id @default(autoincrement())
  inquiryNo       String   @unique
  customerId      Int?
  brandId         Int?
  platformId      Int?
  storeId         Int?
  channelId       Int?
  countryCode     String?
  status          String   @default("new")
  title           String
  content         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  brand           Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  platform        Platform? @relation(fields: [platformId], references: [id], onDelete: SetNull)
  store           Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  channel         Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  quotes          Quote[]
  orders          Order[]

  @@index([customerId])
  @@index([inquiryNo])
  @@index([status])
  @@index([createdAt])
  @@index([brandId])
  @@index([platformId])
  @@index([storeId])
  @@index([channelId])
}

model Quote {
  id              Int      @id @default(autoincrement())
  quoteNo         String   @unique
  inquiryId       Int?
  customerId      Int?
  brandId         Int?
  platformId      Int?
  storeId         Int?
  channelId       Int?
  countryCode     String?
  currency        String   @default("USD")
  productAmount   Decimal  @default(0) @db.Decimal(18, 2)
  shippingFee     Decimal  @default(0) @db.Decimal(18, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(18, 2)
  otherFee        Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal  @default(0) @db.Decimal(18, 2)
  status          String   @default("draft")
  convertedAt     DateTime?
  remark          String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  inquiry         Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  brand           Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  platform        Platform? @relation(fields: [platformId], references: [id], onDelete: SetNull)
  store           Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  channel         Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  items           QuoteItem[]
  order           Order?

  @@index([inquiryId])
  @@index([customerId])
  @@index([brandId])
  @@index([platformId])
  @@index([storeId])
  @@index([channelId])
}

model QuoteItem {
  id          Int      @id @default(autoincrement())
  quoteId     Int
  sku         String?
  productName String
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @db.Decimal(18, 2)
  totalPrice  Decimal  @default(0) @db.Decimal(18, 2)
  remark      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model Order {
  id              Int      @id @default(autoincrement())
  orderNo         String   @unique
  externalOrderNo String?
  orderSource     String   @default("calembou")
  customerId      Int?
  customerName    String?
  salespersonId   Int?
  inquiryId       Int?
  quoteId         Int?     @unique
  brandId         Int?
  platformId      Int?
  storeId         Int?
  channelId       Int?
  influencerCollaborationId Int?
  countryCode     String?
  currency        String   @default("USD")
  exchangeRate    Decimal  @default(1) @db.Decimal(18, 6)
  baseCurrency    String   @default("CNY")
  productAmount   Decimal  @default(0) @db.Decimal(18, 2)
  shippingFee     Decimal  @default(0) @db.Decimal(18, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(18, 2)
  otherFee        Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal  @default(0) @db.Decimal(18, 2)
  salesAmount     Decimal  @default(0) @db.Decimal(18, 2)
  totalCost       Decimal  @default(0) @db.Decimal(18, 2)
  grossProfit     Decimal  @default(0) @db.Decimal(18, 2)
  grossMargin     Decimal? @db.Decimal(9, 4)
  paidAmount      Decimal  @default(0) @db.Decimal(18, 2)
  unpaidAmount    Decimal  @default(0) @db.Decimal(18, 2)
  orderStatus     String   @default("draft")
  paymentStatus   String   @default("unpaid")
  shippingStatus  String   @default("unshipped")
  orderDate       DateTime
  shipmentDate    DateTime?
  paymentMethod   String?
  expectedShipDate DateTime?
  actualShipDate  DateTime?
  dueDate         DateTime?
  trackingNo      String?
  logisticsProvider String?
  remark          String?  @db.Text
  createdBy       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  salesperson     User?    @relation("OrderSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  inquiry         Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  quote           Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  brand           Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  platform        Platform? @relation(fields: [platformId], references: [id], onDelete: SetNull)
  store           Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  channel         Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  influencerCollaboration InfluencerCollaboration? @relation(fields: [influencerCollaborationId], references: [id], onDelete: SetNull)
  creator         User?    @relation("OrderCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  items           OrderItem[]
  costs           OrderCost[]
  statusLogs      OrderStatusLog[]
  payments        OrderPayment[]
  shipments       OrderShipment[]

  @@index([orderSource])
  @@index([orderNo])
  @@index([customerId])
  @@index([customerName])
  @@index([createdBy])
  @@index([salespersonId])
  @@index([inquiryId])
  @@index([brandId])
  @@index([platformId])
  @@index([storeId])
  @@index([channelId])
  @@index([influencerCollaborationId])
  @@index([countryCode])
  @@index([currency])
  @@index([orderDate])
  @@index([shipmentDate])
  @@index([dueDate])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([shippingStatus])
}

model OrderStatusLog {
  id          Int      @id @default(autoincrement())
  orderId     Int
  fromStatus  String?
  toStatus    String
  remark      String?  @db.Text
  createdBy   Int?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creator     User?    @relation("OrderStatusLogCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([toStatus])
  @@index([createdBy])
}

model OrderPayment {
  id            Int      @id @default(autoincrement())
  orderId       Int
  paymentDate   DateTime
  amount        Decimal  @default(0) @db.Decimal(18, 2)
  currency      String   @default("USD")
  exchangeRate  Decimal  @default(1) @db.Decimal(18, 6)
  baseAmount    Decimal  @default(0) @db.Decimal(18, 2)
  paymentMethod String?
  referenceNo   String?
  payerName     String?
  status        String   @default("confirmed")
  remark        String?  @db.Text
  createdBy     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creator       User?    @relation("OrderPaymentCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([paymentDate])
  @@index([status])
  @@index([createdBy])
  @@index([referenceNo])
}

model OrderShipment {
  id                Int      @id @default(autoincrement())
  orderId           Int
  shipmentDate      DateTime
  deliveredAt       DateTime?
  status            String   @default("shipped")
  isFinalShipment   Boolean  @default(true)
  logisticsProvider String?
  trackingNo        String?
  packageCount      Int      @default(1)
  freightAmount     Decimal  @default(0) @db.Decimal(18, 2)
  currency          String   @default("USD")
  exchangeRate      Decimal  @default(1) @db.Decimal(18, 6)
  remark            String?  @db.Text
  createdBy         Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creator           User?    @relation("OrderShipmentCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([shipmentDate])
  @@index([status])
  @@index([createdBy])
  @@index([trackingNo])
}

model Attachment {
  id             Int      @id @default(autoincrement())
  bizType        String
  bizId          Int
  fileName       String
  fileUrl        String
  fileType       String?
  fileSize       Int      @default(0)
  attachmentType String   @default("other")
  uploadedBy     Int?
  createdAt      DateTime @default(now())
  uploader       User?    @relation("AttachmentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([bizType, bizId])
  @@index([attachmentType])
  @@index([uploadedBy])
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int?
  sku         String?
  productName String
  productNameCn String?
  productNameEn String?
  specification String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @db.Decimal(18, 2)
  costPrice   Decimal? @db.Decimal(18, 2)
  totalPrice  Decimal  @default(0) @db.Decimal(18, 2)
  totalCost   Decimal  @default(0) @db.Decimal(18, 2)
  saleUnitPrice Decimal @default(0) @db.Decimal(18, 2)
  salesSubtotal Decimal @default(0) @db.Decimal(18, 2)
  purchaseUnitCost Decimal @default(0) @db.Decimal(18, 2)
  purchaseCurrency String @default("CNY")
  purchaseExchangeRate Decimal @default(1) @db.Decimal(18, 6)
  purchaseCostSubtotal Decimal @default(0) @db.Decimal(18, 2)
  purchaseCostBase Decimal @default(0) @db.Decimal(18, 2)
  packagingUnitCost Decimal @default(0) @db.Decimal(18, 2)
  packagingCurrency String @default("CNY")
  packagingExchangeRate Decimal @default(1) @db.Decimal(18, 6)
  packagingCostSubtotal Decimal @default(0) @db.Decimal(18, 2)
  packagingCostBase Decimal @default(0) @db.Decimal(18, 2)
  remark      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([sku])
  @@index([productName])
  @@index([productNameCn])
  @@index([productNameEn])
}

model OrderCost {
  id           Int      @id @default(autoincrement())
  orderId      Int
  costType     String
  amount       Decimal  @default(0) @db.Decimal(18, 2)
  currency     String   @default("USD")
  exchangeRate Decimal  @default(1) @db.Decimal(18, 6)
  baseAmount   Decimal  @default(0) @db.Decimal(18, 2)
  remark       String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, costType])
  @@index([orderId])
  @@index([costType])
}
